{
  "manifest_version": 3,
  "name": "Endpoint Hunter — API & Route Reconnaissance",
  "version": "10.0.0",
  "description": "The Ultimate Enterprise API Reconnaissance & Vulnerability Suite: Zero-day recon orchestrator, CVSS v3.1 security scorecard, MITRE ATT&CK enterprise mapper, live topology graph visualizer, custom rules engine, memory dump inspector, compliance exporter (OWASP/SOC2/ISO), CLI pipeline bridge, and API schema boundary fuzzer.",
  "author": "Pratik Khairnar <pratik-khairnar-sec@users.noreply.github.com>",
  "homepage_url": "https://github.com/pratik-khairnar-sec/endpoint-finder-extension",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "downloads",
    "scripting",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Endpoint Hunter",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "devtools_page": "devtools.html",
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  }
}